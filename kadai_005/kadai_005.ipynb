      "source": [
        "#上辺：10cm\n",
        "#下辺：20cm\n",
        "#高さ：5cm\n",
        "\n",
        "#公式：台形の面積 =（上辺＋下辺）× 高さ ÷ 2\n",
        "\n",
        "\n",
        "jouhen = 10\n",
        "kahen = 20\n",
        "takasa = 5\n",
        "\n",
        "print(f\"{(jouhen+kahen)*takasa//2}cm²\")\n",
        "\n",
        "\n"
      ]
    }
  ]
}